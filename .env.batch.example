# Dávka nepotřebuje web, callback URL ani přihlášení žáků.
GITHUB_ORG=sposdknl
# Fine-grained personal access token správce: cílová organizace, All repositories,
# Administration: Read and write, Contents: Read-only, Metadata: Read-only.
GITHUB_TOKEN=
# Alternativně místo tokenu lze použít existující GitHub App:
# GITHUB_APP_ID=
# GITHUB_INSTALLATION_ID=
# GITHUB_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
